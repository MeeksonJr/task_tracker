# Environment Variables Example
# Copy to .env and fill in your values

# External API: Public Holidays API (default free endpoint: https://date.nager.at)
HOLIDAYS_API_BASE_URL=https://date.nager.at/api/v3
DEFAULT_COUNTRY_CODE=US

# Firebase Config (Alternative to google-services.json for custom runners)
FIREBASE_PROJECT_ID=task-tracker-app-ba3b2
FIREBASE_STORAGE_BUCKET=task-tracker-app-ba3b2.firebasestorage.app
